# Copy to .env (gitignored) and fill in. Generate secrets with:
#   openssl rand -base64 48   (JWT secret, must be >= 32 chars)
#   openssl rand -hex 24      (internal key, DB password)
DB_PASSWORD=change-me
CHRONOS_JWT_SECRET=change-me-to-at-least-32-random-characters
CHRONOS_INTERNAL_KEY=change-me
CHRONOS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: create an admin at startup. Leave the password empty to skip.
CHRONOS_BOOTSTRAP_ADMIN_USER_ID=admin
CHRONOS_BOOTSTRAP_ADMIN_PASSWORD=

# Optional: SMTP for email jobs (Gmail needs an app password).
MAIL_USERNAME=
MAIL_PASSWORD=
